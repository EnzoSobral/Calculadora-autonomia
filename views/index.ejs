<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Autonomia de Carro Elétrico</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <div class="container">

        <div class="header">
            <div class="icone">⚡</div>
            <h1>Calculadora de Autonomia</h1>
            <p>Descubra até onde seu carro elétrico pode chegar</p>
        </div>

        <div class="formulario">
            <form action="/" method="POST">

                <div class="campo">
                    <label for="consumo">Consumo do veículo (km/kWh)</label>
                    <input
                        type="number"
                        id="consumo"
                        name="consumo"
                        placeholder="Ex: 6"
                        step="0.1"
                        min="0"
                        value="<%= consumo %>"
                        required
                    >
                </div>

                <div class="campo">
                    <label for="energia">Energia disponível na bateria (kWh)</label>
                    <input
                        type="number"
                        id="energia"
                        name="energia"
                        placeholder="Ex: 50"
                        step="0.1"
                        min="0"
                        value="<%= energia %>"
                        required
                    >
                </div>

                <button type="submit">Calcular Autonomia</button>

            </form>
        </div>

        <% if (resultado !== null) { %>
        <div class="resultado">
            <div class="resultado-icone">🚗</div>
            <p class="resultado-label">Distância máxima da viagem</p>
            <p class="resultado-valor"><%= resultado %> <span>km</span></p>
            <p class="resultado-detalhe">
                Com <%= consumo %> km/kWh e <%= energia %> kWh disponíveis
            </p>
        </div>
        <% } %>

    </div>

</body>
</html>